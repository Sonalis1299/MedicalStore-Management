<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Medicines Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/home.css" rel="stylesheet" type="text/css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h2 class="mb-4">Medicines Inventory</h2>
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Medicine ID</th>
                    <th>Medicine Code</th>
                    <th>Medicine Name</th>
                    <th>Quantity</th>
                    <th>Medicine Type</th>
                    <th>Manufacture Date</th>
                    <th>Expiry Date</th>
                    <th>Manufacturer</th>
                    <th>Price</th>
                    <th>Deletion</th>
                    <th>Updation</th>
                </tr>
            </thead>
            <tbody>
                <% medicines.forEach(medicine => { %>
                    <tr>
                        <td><%= medicine.medicineID %></td>
                        <td><%= medicine.medicineCode %></td>
                        <td><%= medicine.medicineName %></td>
                        <td><%= medicine.quantity %></td>
                        <td><%= medicine.medicineType %></td>
                        <td><%= new Date(medicine.manufactureDate).toLocaleDateString() %></td>
                        <td><%= new Date(medicine.expiryDate).toLocaleDateString() %></td>
                        <td><%= medicine.manufacturer %></td>
                        <td>$<%= parseFloat(medicine.price).toFixed(2) %></td>
                        
                        <td>
                            <button type="button" class="btn btn-danger delete-btn" data-id="<%= medicine.medicineID %>">Delete</button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-success edit-btn" data-id="<%= medicine.medicineID %>">Edit</button>
                        </td>
                        
                    </tr>
                <% }) %>
            </tbody>
            
        </table>
    </div>

    
    

</body>
</html>



<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Delete button functionality
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', async (event) => {
                event.preventDefault(); // Prevent any default action
                
                const medicineID = button.getAttribute('data-id');

                // Confirm the deletion
                const confirmed = confirm(`Are you sure you want to delete Medicine ID ${medicineID}?`);
                if (!confirmed) return;

                try {
                    // Send AJAX request to delete the record
                    const response = await fetch(`/medicines/delete/${medicineID}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                    });

                    if (response.ok) {
                        // Remove the row from the table
                        button.closest('tr').remove();
                        alert('Record deleted successfully!');
                    } else {
                        const errorData = await response.json();
                        console.error('Error:', errorData.error);
                        alert('Failed to delete the record. Please try again.');
                    }
                } catch (error) {
                    console.error('AJAX Error:', error);
                    alert('An error occurred while deleting the record.');
                }
            });
        });

        // Edit button functionality
        document.querySelectorAll('.edit-btn').forEach(button => {
            button.addEventListener('click', (event) => {
                event.preventDefault(); // Prevent any default action

                const medicineID = button.getAttribute('data-id');

                // Redirect to the edit page
                window.location.href = `/medicines/update/${medicineID}`;
            });
        });
    });
</script>

