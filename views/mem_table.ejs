<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Members Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/home.css" rel="stylesheet" type="text/css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h2 class="mb-4">Members Inventory</h2>
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Member ID</th>
                    <th>Membership ID</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Contact Number</th>
                    <th>Deletion</th>
                    <th>Updation</th>
                </tr>
            </thead>
            <tbody>
                <% members.forEach(member => { %>
                    <tr>
                        <td><%= member.member_id %></td>
                        <td><%= member.membership_id %></td>
                        <td><%= member.start_date %></td>
                        <td><%= member.end_date %></td>
                        <td><%= member.contact_number %></td>
                        
                        <td>
                            <button type="button" class="btn btn-danger delete-btn" data-id="<%= member.member_id %>">Delete</button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-success edit-btn" data-id="<%= member.member_id %>">Edit</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Delete button functionality
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', async (event) => {
                event.preventDefault(); // Prevent any default action
                
                const memberID = button.getAttribute('data-id');

                // Confirm the deletion
                const confirmed = confirm(`Are you sure you want to delete Member ID ${memberID}?`);
                if (!confirmed) return;

                try {
                    // Send AJAX request to delete the record
                    const response = await fetch(`/members/delete/${memberID}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                    });

                    if (response.ok) {
                        // Remove the row from the table
                        button.closest('tr').remove();
                        alert('Member deleted successfully!');
                    } else {
                        const errorData = await response.json();
                        console.error('Error:', errorData.error);
                        alert('Failed to delete the member. Please try again.');
                    }
                } catch (error) {
                    console.error('AJAX Error:', error);
                    alert('An error occurred while deleting the member.');
                }
            });
        });

        // Edit button functionality
        document.querySelectorAll('.edit-btn').forEach(button => {
            button.addEventListener('click', (event) => {
                event.preventDefault(); // Prevent any default action

                const memberID = button.getAttribute('data-id');

                // Redirect to the edit page
                window.location.href = `/members/update/${memberID}`;
            });
        });
    });
</script>
